rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- membership helpers for sub-collections (boards, items) ----
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).memberIds;
    }

    // The creator is always an admin; legacy groups without a roles map treat everyone else as guest.
    function isAdmin(groupId) {
      return isMember(groupId)
        && (request.auth.uid == groupData(groupId).ownerId
            || groupData(groupId).get('roles', {}).get(request.auth.uid, 'guest') == 'admin');
    }

    // Lifetime image-upload counter per person (characters of stored image data).
    // It can only grow and never past the cap; image items require it to grow with them.
    match /usage/{userId} {
      function validUsage() {
        return request.resource.data.keys().hasOnly(['imageBytes', 'lastImageId', 'lastRemoved'])
          && (!('lastImageId' in request.resource.data) || request.resource.data.lastImageId is string)
          && (!('lastRemoved' in request.resource.data) || request.resource.data.lastRemoved is map)
          && request.resource.data.imageBytes is number
          && request.resource.data.imageBytes >= 0
          && request.resource.data.imageBytes <= 30000000;
      }
      // Path of the image item the user says they deleted in this same write.
      function removedPath() {
        let r = request.resource.data.lastRemoved;
        return /databases/$(database)/documents/groups/$(r.g)/boards/$(r.b)/items/$(r.i);
      }
      // The counter may only go DOWN together with the deletion of one of the user's own
      // image items, and by exactly that image's size (so storage is refunded, never invented).
      function refundOk() {
        return 'lastRemoved' in request.resource.data
          && request.resource.data.lastRemoved is map
          && request.resource.data.lastRemoved.keys().hasOnly(['g', 'b', 'i'])
          && exists(removedPath())
          && !existsAfter(removedPath())
          && get(removedPath()).data.get('type', '') == 'image'
          && get(removedPath()).data.get('authorId', '') == request.auth.uid
          && resource.data.imageBytes - request.resource.data.imageBytes == get(removedPath()).data.src.size();
      }

      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && userId == request.auth.uid && validUsage();
      allow update: if signedIn() && userId == request.auth.uid && validUsage()
        && (request.resource.data.imageBytes >= resource.data.imageBytes || refundOk());
    }

    match /groups/{groupId} {

      // ---- helpers for the group document itself ----
      function uid() {
        return request.auth.uid;
      }
      function oldRoles() {
        return resource.data.get('roles', {});
      }
      function oldProfiles() {
        return resource.data.get('profiles', {});
      }
      function newRoles() {
        return request.resource.data.get('roles', {});
      }
      function newProfiles() {
        return request.resource.data.get('profiles', {});
      }
      function changedRoles() {
        return newRoles().diff(oldRoles()).affectedKeys();
      }
      function changedProfiles() {
        return newProfiles().diff(oldProfiles()).affectedKeys();
      }
      function onlyTouches(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function wasMember() {
        return uid() in resource.data.memberIds;
      }
      function wasAdmin() {
        return wasMember()
          && (uid() == resource.data.ownerId || oldRoles().get(uid(), 'guest') == 'admin');
      }
      function validProfile(p) {
        return p is map
          && p.keys().hasOnly(['name', 'photoURL'])
          && p.name is string && p.name.size() <= 100
          && p.photoURL is string && p.photoURL.size() <= 500;
      }

      // A signed-in user joins by adding only themselves as a guest.
      function isJoining() {
        return onlyTouches(['memberIds', 'roles', 'profiles'])
          && !(uid() in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && uid() in request.resource.data.memberIds
          && changedRoles().hasOnly([uid()])
          && newRoles()[uid()] == 'guest'
          && changedProfiles().hasOnly([uid()])
          && validProfile(newProfiles()[uid()]);
      }

      // A member may refresh only their own profile (name / photo).
      function isOwnProfileUpdate() {
        return wasMember()
          && onlyTouches(['profiles'])
          && changedProfiles().hasOnly([uid()])
          && validProfile(newProfiles()[uid()]);
      }

      // Admins change roles of members, never the creator's.
      function isRoleChange() {
        return wasAdmin()
          && onlyTouches(['roles'])
          && changedRoles().hasOnly(resource.data.memberIds)
          && !changedRoles().hasAny([resource.data.ownerId])
          && newRoles().values().hasOnly(['admin', 'guest']);
      }

      // Only admins rename the group, and nothing else changes.
      function isRename() {
        return wasAdmin()
          && onlyTouches(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
      }

      function removedMembers() {
        return resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet());
      }

      // Exactly one member leaves: an admin removes someone (never the creator),
      // or a member removes themselves (the creator cannot leave).
      // The only role/profile entries that may change are the removed member's,
      // and they must be gone afterwards.
      function isRemoval() {
        return onlyTouches(['memberIds', 'roles', 'profiles'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && resource.data.ownerId in request.resource.data.memberIds
          && changedRoles().hasOnly(removedMembers())
          && changedProfiles().hasOnly(removedMembers())
          && !removedMembers().hasAny(newRoles().keys())
          && !removedMembers().hasAny(newProfiles().keys())
          && (wasAdmin() || (wasMember() && removedMembers().hasOnly([uid()])));
      }

      // get by id is open to signed-in users so the id works as an invite code;
      // listing is only possible through a memberIds query.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'roles', 'profiles', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.roles.keys().hasOnly([uid()])
        && request.resource.data.roles[uid()] == 'admin'
        && request.resource.data.profiles.keys().hasOnly([uid()])
        && validProfile(request.resource.data.profiles[uid()]);

      allow update: if signedIn()
        && (isJoining() || isOwnProfileUpdate() || isRoleChange() || isRemoval() || isRename());

      // Presence: members read everyone's last-seen; each member writes only their own.
      match /presence/{userId} {
        allow read: if isMember(groupId);
        allow create, update: if isMember(groupId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time;
      }

      // Boards: any member can read; only admins create, rename or delete them.
      // Any member may only "touch" a board (last-edit stamp) when contributing items.
      match /boards/{boardId} {
        function boardChanged(keys) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
        }
        function stampedByMe() {
          return request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid;
        }

        allow read: if isMember(groupId);
        allow create: if isAdmin(groupId)
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
        allow delete: if isAdmin(groupId);
        allow update: if (isMember(groupId)
            && boardChanged(['updatedAt', 'updatedBy'])
            && stampedByMe())
          || (isAdmin(groupId)
            && boardChanged(['name', 'updatedAt', 'updatedBy'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
            && stampedByMe());

        // Items: any member (admin or guest) contributes.
        match /items/{itemId} {
          function isImage() {
            return request.resource.data.get('type', '') == 'image';
          }
          function imageChars() {
            return request.resource.data.get('src', '').size();
          }
          function usagePath() {
            return /databases/$(database)/documents/usage/$(request.auth.uid);
          }
          function usedBefore() {
            return exists(usagePath()) ? get(usagePath()).data.imageBytes : 0;
          }
          // An image must be paid for in the same write: the uploader's lifetime counter
          // has to grow by at least the image size (and usage/{uid} caps the counter).
          function imageAllowed() {
            return request.resource.data.src is string
              && imageChars() > 0
              && imageChars() <= 400000
              && request.resource.data.authorId == request.auth.uid
              && getAfter(usagePath()).data.imageBytes >= usedBefore() + imageChars()
              // Only the item named by the counter's lastImageId can ride on this increase,
              // so one increase can never pay for several images in the same batch.
              && getAfter(usagePath()).data.get('lastImageId', '') == itemId;
          }
          // Items may only contain the fields the app writes (no hidden payloads).
          function allowedKeys() {
            return request.resource.data.keys().hasOnly([
              'type', 'text', 'src', 'cols', 'cells', 'tasks', 'title', 'url',
              'color', 'span', 'fontSize', 'header', 'order', 'createdAt', 'authorId'
            ]);
          }
          // Size limits (keep in sync with src/lib/limits.ts). Rules cannot measure strings
          // inside arrays, so tasks and cells are limited by count only.
          function validContent() {
            let d = request.resource.data;
            return d.get('text', '') is string && d.get('text', '').size() <= 20000
              && d.get('title', '') is string && d.get('title', '').size() <= 100
              && d.get('url', '') is string && d.get('url', '').size() <= 2048
              && d.get('tasks', []) is list && d.get('tasks', []).size() <= 100
              && d.get('cells', []) is list && d.get('cells', []).size() <= 200
              && (!('cols' in d) || (d.cols is number && d.cols >= 1 && d.cols <= 10));
          }
          // Style edits never change what an image (or any item) is.
          function sameContentKind() {
            return request.resource.data.get('type', '') == resource.data.get('type', '')
              && request.resource.data.get('src', '') == resource.data.get('src', '')
              && request.resource.data.get('authorId', '') == resource.data.get('authorId', '');
          }

          allow read: if isMember(groupId);
          // Non-image items may not carry an image payload.
          allow create: if isMember(groupId)
            && allowedKeys()
            && validContent()
            && (isImage() ? imageAllowed() : !('src' in request.resource.data));
          allow update: if isMember(groupId) && allowedKeys() && validContent() && sameContentKind();
          allow delete: if isMember(groupId);
        }
      }
    }
  }
}
